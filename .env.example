# Optional local/server runtime overrides.
# Do not commit real credentials or private keys.

# Express/Cloud Run port. Cloud Run sets PORT automatically.
PORT=8080

# Set to production only for production-style static serving.
NODE_ENV=development

# Privileged Google Cloud and Firebase Admin calls use Application Default
# Credentials (ADC). Prefer `gcloud auth application-default login` locally.
# If your environment requires a service-account file, keep it OUTSIDE the repo
# and point ADC at it with GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# Browser Firebase configuration is currently loaded from
# firebase-applet-config.json, not from NEXT_PUBLIC_* or VITE_* env vars.
# Do not treat Firebase web config as a secret or authorization boundary.
