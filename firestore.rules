rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isFounder() {
      return request.auth != null
        && request.auth.token.email == 'musclehed03@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isArchitect() {
      return isFounder()
        || (
          request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'architect'
        );
    }
    function isPublicConfig(configId) {
      return configId in ['liveStatus', 'schedule', 'contentLinks', 'brandSocials'];
    }
    // Users may read their own profile and update only social handles.
    // Roles and unlocked entitlements are not client-writable.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['unlockedAssets', 'socialHandles'])
        && request.resource.data.unlockedAssets is list
        && request.resource.data.unlockedAssets.size() == 0
        && request.resource.data.socialHandles is map;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['socialHandles'])
        && request.resource.data.socialHandles is map;
      allow delete: if false;
    }
    // Public gallery metadata and founder/architect-controlled writes.
    match /studioItems/{itemId} {
      allow read: if true;
      allow write: if isArchitect();
    }
    // Authenticated members may read vault metadata; only founder/architects write.
    match /vaultItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if isArchitect();
    }
    // Members may use the social feed. Ownership restrictions can be added when
    // the Circuit feature is connected to Firestore.
    match /posts/{postId} {
      allow read, write: if request.auth != null;
    }
    // Public site settings are readable; only the founder may change settings
    // or read the private webhook document.
    match /config/{configId} {
      allow read: if isFounder() || isPublicConfig(configId);
      allow write: if isFounder();
    }
  }
}
