rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isFounder() {
      return request.auth != null
        && request.auth.token.email == 'musclehed03@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isArchitect() {
      return isFounder()
        || (
          request.auth != null
          && firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.role == 'architect'
        );
    }

    match /gallery/studio/{fileName=**} {
      allow read: if true;
      allow create, update: if isArchitect()
        && request.resource.size < 20971520
        && request.resource.contentType.matches('image/.*');
      allow delete: if isArchitect();
    }

    match /gallery/vault/{fileName=**} {
      allow read: if request.auth != null;
      allow create, update: if isArchitect()
        && request.resource.size < 20971520
        && request.resource.contentType.matches('image/.*');
      allow delete: if isArchitect();
    }
  }
}
